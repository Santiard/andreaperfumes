# Configuración de Entorno - Andrea Perfumes
APP_ENV=development
APP_URL=http://localhost:8080
APP_PORT=8080

# Base de Datos MariaDB 11
DB_HOST=db
DB_PORT=3306
DB_DATABASE=andreaperfumes
DB_USERNAME=andrea_user
DB_PASSWORD=andrea_secret_pass
DB_ROOT_PASSWORD=root_secret_pass
DB_EXTERNAL_PORT=3307

# Seguridad JWT (Cambiar en producción en el VPS)
JWT_SECRET=andrea_perfumes_jwt_super_secret_key_2026_change_in_prod
JWT_EXPIRATION_SECONDS=86400

# Configuración de procesamiento WebP
WEBP_MAX_DIMENSION=1000
WEBP_QUALITY=82
MAX_UPLOAD_BYTES=10485760

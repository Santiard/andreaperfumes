{
    "name": "andreaperfumes/backend",
    "description": "API REST y Motor SEO para el catálogo e-commerce de Andrea Perfumes (PHP 8.3 + MariaDB 11 + WebP)",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}

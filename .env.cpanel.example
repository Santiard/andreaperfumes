# =============================================================================
# VARIABLES DE ENTORNO PARA CPANEL (dreaperfumes.com)
# Renombrar este archivo a '.env' en la raíz de public_html
# =============================================================================

APP_ENV=production
APP_URL=https://dreaperfumes.com

# Credenciales de Base de Datos MySQL creadas en cPanel
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=dreaperfumes_db
DB_USERNAME=dreaperfumes_user
DB_PASSWORD=TuPasswordSeguroDeMySQLAqui

# Seguridad JWT para el Panel de Administración (Generar clave aleatoria)
JWT_SECRET=drea_perfumes_super_secure_production_jwt_key_2026_xyz
JWT_EXPIRATION_SECONDS=86400

# Optimización de Imágenes
WEBP_MAX_DIMENSION=1000
WEBP_QUALITY=82
MAX_UPLOAD_BYTES=10485760
TZ=America/Bogota
